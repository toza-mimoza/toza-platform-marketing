# Tenant app SPA — console, demo, customer instances (*.toza-platform.com).
# Install as /etc/nginx/sites-available/toza-app on the VPS (from toza-platform docs).

server {
    listen 80;
    listen [::]:80;
    server_name *.toza-platform.com;
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name *.toza-platform.com;

    # Add explicit -d names via certbot as instances go live, or use DNS wildcard cert.
    ssl_certificate     /etc/letsencrypt/live/toza-platform.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/toza-platform.com/privkey.pem;

    root /var/www/toza/frontend;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
